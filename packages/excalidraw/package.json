{
  "name": "@bizimind/excalidraw-cli",
  "version": "0.1.0",
  "description": "CLI for agents to create, edit, and view Excalidraw diagrams",
  "bin": {
    "excalidraw": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build.ts",
    "install-global": "bun install.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm -w run lint",
    "lint:fix": "pnpm -w run lint:fix",
    "fmt": "pnpm -w run fmt",
    "fmt:check": "pnpm -w run fmt:check"
  },
  "dependencies": {
    "@bizimind/cli-common": "workspace:*",
    "@excalidraw/element": "0.18.0-9036812b6",
    "@excalidraw/mermaid-to-excalidraw": "^2.3.0",
    "@excalidraw/utils": "^0.1.7",
    "@napi-rs/canvas": "^1.0.13",
    "commander": "^15.0.0",
    "linkedom": "^0.18.14",
    "roughjs": "^4.6.6",
    "svg-path-bbox": "^2.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "^24.19.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
