{
  "name": "@bizimind/wt",
  "version": "0.1.58",
  "description": "CLI for managing git worktrees with port offsetting, unique naming, and hooks",
  "type": "module",
  "exports": {
    ".": "./src/cli.ts",
    "./lib": "./src/lib/index.ts",
    "./config/json-schema": "./src/config/json-schema.ts"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/wt",
    "build:config-schema": "bun src/config/json-schema.ts",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "lint": "pnpm -w run lint",
    "lint:fix": "pnpm -w run lint:fix",
    "fmt": "pnpm -w run fmt",
    "fmt:check": "pnpm -w run fmt:check"
  },
  "dependencies": {
    "@bizimind/cli-common": "workspace:*",
    "@inquirer/prompts": "^8.6.0",
    "commander": "^15.0.0",
    "yaml": "^2.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^24.13.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
