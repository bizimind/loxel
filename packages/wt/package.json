{
  "name": "@bizimind/wt",
  "version": "0.1.60",
  "description": "Configless CLI for managing git worktrees with shell hooks",
  "type": "module",
  "exports": {
    ".": "./src/cli.ts",
    "./lib": "./src/lib/index.ts"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/wt",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "pnpm -w run lint",
    "lint:fix": "pnpm -w run lint:fix",
    "fmt": "pnpm -w run fmt",
    "fmt:check": "pnpm -w run fmt:check"
  },
  "dependencies": {
    "@bizimind/cli-common": "workspace:*",
    "@inquirer/prompts": "^8.6.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
