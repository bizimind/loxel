---
import Base from "./Base.astro";
import DocsNav from "../components/DocsNav.astro";
import { getCollection } from "astro:content";
import { trackScrollDepth } from "../lib/analytics";
import { pagePath } from "../lib/site";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const currentPath = pagePath(Astro.url);
const allDocs = await getCollection("docs");
const currentSlug = allDocs.find((doc) => currentPath === `/docs/${doc.id}`)?.id ?? currentPath;
---

<Base title={title} description={description} ogType="article">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex gap-12">
    <aside class="hidden lg:block w-56 flex-shrink-0">
      <DocsNav currentSlug={currentSlug} class="sticky top-20" />
    </aside>
    <article
      class="flex-1 min-w-0 prose max-w-3xl"
      {...trackScrollDepth("docs_scroll_depth", { slug: currentSlug })}
    >
      <slot />
    </article>
  </div>
</Base>
