---
import DocsNav from "../components/DocsNav.astro";
import Base from "../layouts/Base.astro";
import { trackLoad } from "../lib/analytics";
---

<!-- Built to 404.html, which Cloudflare Pages serves with a 404 status for any unknown path. -->
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="px-4 sm:px-6 py-32 text-center" {...trackLoad("page_not_found", {})}>
    <p class="text-sm font-semibold text-accent mb-3">404</p>
    <h1 class="text-4xl font-bold text-foreground mb-4 text-balance">Page not found</h1>
    <p class="text-muted-foreground mb-10 text-balance">
      The page you're looking for doesn't exist or has moved.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4 text-sm">
      <a
        href="/docs/getting-started"
        class="bg-primary text-primary-foreground hover:bg-accent rounded-md px-5 py-2.5 font-semibold transition-colors"
      >
        Getting started
      </a>
      <a
        href="/download"
        class="border border-border text-foreground hover:border-muted-foreground rounded-md px-5 py-2.5 font-medium transition-colors"
      >
        Download
      </a>
      <a
        href="/"
        class="border border-border text-foreground hover:border-muted-foreground rounded-md px-5 py-2.5 font-medium transition-colors"
      >
        Home
      </a>
    </div>
    <!-- A docs page that moved is most likely still in the list; shown only under /docs/. -->
    <div id="docs-pages" class="mt-16 hidden max-w-xs mx-auto text-left">
      <DocsNav currentSlug="404" />
    </div>
  </section>
</Base>

<script is:inline>
  if (location.pathname.startsWith("/docs/")) {
    document.getElementById("docs-pages")?.classList.remove("hidden");
  }
</script>
