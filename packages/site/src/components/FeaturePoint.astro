---
// One line under a feature section's body, with an icon in an accent-tinted tile.
import { FEATURE_ICONS, type FeatureIcon } from "../lib/feature-icons";

interface Props {
  icon: FeatureIcon;
}

const { icon } = Astro.props;
---

<li class="flex items-center gap-3">
  <span
    class="grid size-8 shrink-0 place-items-center rounded-lg border border-accent/30 bg-accent/10 text-accent-soft"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={FEATURE_ICONS[icon]}
    />
  </span>
  <span class="text-pretty"><slot /></span>
</li>
