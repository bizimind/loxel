{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": { "@/*": ["./src/*"] },
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "../../node_modules", "**/node_modules/**", "**/.bun/**", "dist"]
}
