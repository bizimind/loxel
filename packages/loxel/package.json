{
  "name": "@bizimind/loxel",
  "version": "0.1.159",
  "description": "IDE for the agentic coding era",
  "homepage": "https://github.com/bizimind/loxel",
  "author": {
    "name": "loxel",
    "email": "loxel@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "LOXEL_DEV=1 bun src/server/index.ts & vite",
    "dev:server": "LOXEL_DEV=1 bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && bun build src/server/index.ts --outdir dist/server --target bun",
    "build:ui": "vite build",
    "build:server": "bun build src/server/index.ts --outdir dist/server --target bun",
    "start": "bun dist/server/index.js",
    "prod": "pnpm run build && pnpm run start",
    "dev:app": "ELECTRON=1 vite",
    "build:app": "pnpm run build:server:standalone && ELECTRON=1 vite build && electron-builder",
    "build:app:local": "pnpm run build:server:standalone && ELECTRON=1 vite build && electron-builder --mac --dir --arm64",
    "build:astro-ls": "bun scripts/build-astro-ls.ts",
    "build:yaml-lsp": "bun scripts/build-yaml-lsp.ts",
    "download:docker-lsp": "bun scripts/download-docker-lsp.ts",
    "download:terraform-ls": "bun scripts/download-terraform-ls.ts",
    "download:xml-lsp": "bun scripts/download-xml-lsp.ts",
    "build:pyright-lsp": "bun scripts/build-pyright-lsp.ts",
    "build:cli": "bun build src/cli.ts --compile --outfile build/loxel",
    "build:server:standalone": "bun build src/server/index.ts --compile --outfile build/loxel-server && pnpm run build:yaml-lsp && pnpm run build:pyright-lsp && pnpm run build:astro-ls && pnpm run download:docker-lsp && pnpm run download:terraform-ls && pnpm run download:xml-lsp && bun scripts/copy-typescript.ts",
    "sign": "codesign --sign \"$LOXEL_CODESIGN_IDENTITY\" --options runtime build/loxel-server",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "bun test src --isolate --preload ./src/test/dom-preload.ts --preload ./src/test/jest-dom-preload.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "pnpm -w run lint",
    "lint:fix": "pnpm -w run lint:fix",
    "fmt": "pnpm -w run fmt",
    "fmt:check": "pnpm -w run fmt:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@bizimind/coding-agent": "workspace:*",
    "@bizimind/localdb-sdk": "workspace:*",
    "@bizimind/logger": "workspace:*",
    "@bizimind/monaco-lsp-client": "workspace:*",
    "@bizimind/wt": "workspace:*",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.0",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@shikijs/monaco": "^4.4.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/mdast": "^4.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "diff": "^9.0.0",
    "dockview": "^8.2.0",
    "dockview-react": "^8.2.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.35.0",
    "monaco-editor": "0.56.0",
    "picomatch": "^4.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.16.15",
    "@happy-dom/global-registrator": "^20.11.13",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bun": "1.4.0",
    "@types/node": "^24.13.3",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "pyright": "^1.1.413",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.1.1",
    "yaml-language-server": "^1.24.0"
  }
}
