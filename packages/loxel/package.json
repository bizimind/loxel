{
  "name": "@bizimind/loxel",
  "version": "0.1.150",
  "description": "IDE for the agentic coding era",
  "homepage": "https://github.com/bizimind/loxel",
  "author": {
    "name": "loxel",
    "email": "loxel@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "LOXEL_DEV=1 bun run src/server/index.ts & vite",
    "dev:server": "LOXEL_DEV=1 bun run --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && bun build src/server/index.ts --outdir dist/server --target bun",
    "build:ui": "vite build",
    "build:server": "bun build src/server/index.ts --outdir dist/server --target bun",
    "start": "bun run dist/server/index.js",
    "prod": "bun run build && bun run start",
    "dev:app": "ELECTRON=1 vite",
    "build:app": "bun run build:icon && bun run build:server:standalone && ELECTRON=1 vite build && electron-builder",
    "build:app:local": "bun run build:icon && bun run build:server:standalone && ELECTRON=1 vite build && electron-builder --mac --dir --arm64",
    "build:icon": "mkdir -p build && rsvg-convert -w 1024 -h 1024 public/favicon.svg -o build/icon.png",
    "build:astro-ls": "bun run scripts/build-astro-ls.ts",
    "build:yaml-lsp": "bun run scripts/build-yaml-lsp.ts",
    "download:docker-lsp": "bun run scripts/download-docker-lsp.ts",
    "download:terraform-ls": "bun run scripts/download-terraform-ls.ts",
    "download:xml-lsp": "bun run scripts/download-xml-lsp.ts",
    "build:pyright-lsp": "bun run scripts/build-pyright-lsp.ts",
    "build:ts-lsp": "bun run scripts/build-ts-lsp.ts",
    "build:cli": "bun build src/cli.ts --compile --outfile build/loxel",
    "build:server:standalone": "bun build src/server/index.ts --compile --outfile build/loxel-server && bun run build:yaml-lsp && bun run build:pyright-lsp && bun run build:astro-ls && bun run build:ts-lsp && bun run download:docker-lsp && bun run download:terraform-ls && bun run download:xml-lsp && bun run scripts/copy-tsgo.ts",
    "sign": "codesign --sign \"$LOXEL_CODESIGN_IDENTITY\" --options runtime build/loxel-server",
    "typecheck": "tsgo --noEmit",
    "preview": "vite preview",
    "test": "bun test src --isolate --preload ./src/test/dom-preload.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@bizimind/coding-agent": "workspace:*",
    "@bizimind/keychain": "workspace:*",
    "@bizimind/localdb-sdk": "workspace:*",
    "@bizimind/logger": "workspace:*",
    "@bizimind/monaco-lsp-client": "workspace:*",
    "@bizimind/wt": "workspace:*",
    "@codemirror/language": "^6.12.2",
    "@codemirror/view": "^6.40.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.0",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.19.0",
    "@milkdown/kit": "^7.19.0",
    "@shikijs/monaco": "^4.0.2",
    "@tanstack/react-query": "^5.91.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/mdast": "^4.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "diff": "^9.0.0",
    "dockview": "^6.0.1",
    "dockview-react": "^6.0.1",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.0.0",
    "monaco-editor": "0.55.1",
    "motion": "^12.29.0",
    "picomatch": "^4.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.0.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.3",
    "zod": "^4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.16.9",
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "pyright": "^1.1.409",
    "tailwindcss": "^4.1.8",
    "typescript-language-server": "^5.1.3",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^1.0.0-beta.3",
    "yaml-language-server": "^1.21.0"
  }
}
