       for (const { fileAccessType, isDirectory, filePath } of permissionChecks) {
         expect(['writable', 'readable']).toContain(fileAccessType);
@@ -1741,6 +1742,52 @@ describe('chromium features', () => {
       }
     });
 
+    it('asks the request handler before writing a readable file whose checks are allowed', async () => {
+      const writablePath = path.join(fixturesPath, 'file-system', 'test-perms.html');
+      const testFile = path.join(fixturesPath, 'file-system', 'test.txt');
+      const permissionRequests: unknown[] = [];
+
+      const w = new BrowserWindow({
+        show: false,
+        webPreferences: {
+          nodeIntegration: true,
+          session: ses,
+          contextIsolation: false,
+          sandbox: false
+        }
+      });
+
+      ses.setPermissionCheckHandler((_wc, permission) => permission === 'fileSystem');
+      ses.setPermissionRequestHandler((_wc, permission, callback, details) => {
+        if (permission === 'fileSystem') permissionRequests.push(details);
+        callback(false);
+      });
+
+      await w.loadFile(writablePath);
+      expect(await pasteFileUri(w, testFile)).toBe('did-create-file-handle');
+      expect(await w.webContents.executeJavaScript('handle.queryPermission({ mode: "read" })')).toBe('granted');
+      expect(await w.webContents.executeJavaScript('handle.queryPermission({ mode: "readwrite" })')).toBe('prompt');
+      // webFrameMain.executeJavaScript(), so that the browser process knows of
+      // the user activation before the request (see above).
+      const writeError = await w.webContents.mainFrame.executeJavaScript(
+        `
+        (async () => {
+          try {
+            await handle.createWritable();
+            return null;
+          } catch (error) {
+            return error.name;
+          }
+        })()
+      `,
+        true
+      );
+      expect(writeError).toBe('NotAllowedError');
+      expect(permissionRequests).toEqual([
+        expect.objectContaining({ fileAccessType: 'writable', isDirectory: false, filePath: testFile })
+      ]);
+    });
+
     it('correctly denies permissions after creating a readable directory handle', async () => {
       const permPath = path.join(fixturesPath, 'file-system', 'test-perms.html');
       const testDir = path.join(fixturesPath, 'file-system');
