   switch (reason) {
@@ -344,23 +345,26 @@ void ElectronAuthenticatorRequestClientDelegate::ConfigureDiscoveries(
   // transport. A restart from StartOver() keeps the QR code the app is
   // already showing.
   if (!hybrid_qr_generator_key_) {
-    std::array<uint8_t, device::cablev2::kQRKeySize> qr_generator_key;
-    crypto::RandBytes(qr_generator_key);
-    const std::string qr_code =
-        device::cablev2::qr::Encode(qr_generator_key, request_type);
-
     // The app renders the QR code, so hybrid is only useful when a listener
     // exists. Without one, leave the transport unconfigured so the remaining
     // authenticators behave exactly as before.
-    base::WeakPtr<ElectronAuthenticatorRequestClientDelegate> weak_this =
-        weak_factory_.GetWeakPtr();
-    if (!EmitHybridRequestEvent(request_type, qr_code) || !weak_this) {
+    if (!HasSessionListener(kHybridRequestEventName)) {
       return;
     }
+    std::array<uint8_t, device::cablev2::kQRKeySize> qr_generator_key;
+    crypto::RandBytes(qr_generator_key);
+    hybrid_qr_code_ =
+        device::cablev2::qr::Encode(qr_generator_key, request_type);
+    hybrid_request_type_ = request_type;
     hybrid_qr_generator_key_ = qr_generator_key;
   }
 
-  hybrid_browser_context_ = browser_context;
+  // The event waits for OnTransportAvailabilityEnumerated(): the transports
+  // passed to the request handler are not known here, and an allow list can
+  // exclude hybrid (e.g. every credential lists only "internal"). Offering a
+  // QR code then would leave the phone waiting for a desktop that never
+  // listens.
+  hybrid_pending_browser_context_ = browser_context;
   fido_discovery_factory->set_cable_data(request_type,
                                          *hybrid_qr_generator_key_);
   fido_discovery_factory->set_network_context_factory(
@@ -396,7 +400,7 @@ bool ElectronAuthenticatorRequestClientDelegate::EmitHybridRequestEvent(
                                            .ToLocalChecked();
 
   v8::Local<v8::Value> emit_result =
-      gin_helper::EmitEvent(isolate, session_wrapper, "webauthn-hybrid-request",
+      gin_helper::EmitEvent(isolate, session_wrapper, kHybridRequestEventName,
                             event_object, details);
 
   // EventEmitter.prototype.emit() returns true iff there was at least one
@@ -612,6 +616,24 @@ void ElectronAuthenticatorRequestClientDelegate::FidoAuthenticatorAdded(
 void ElectronAuthenticatorRequestClientDelegate::
     OnTransportAvailabilityEnumerated(
         device::FidoRequestHandlerBase::TransportAvailabilityInfo data) {
+  // Offer the QR code once, and only when the request handler actually runs
+  // a hybrid discovery: it is absent when the allow list excludes hybrid or
+  // the factory could not create one. A restart keeps the code already shown.
+  if (hybrid_qr_generator_key_ && !hybrid_browser_context_ &&
+      data.available_transports.contains(
+          device::FidoTransportProtocol::kHybrid)) {
+    base::WeakPtr<ElectronAuthenticatorRequestClientDelegate> weak_this =
+        weak_factory_.GetWeakPtr();
+    const bool shown =
+        EmitHybridRequestEvent(hybrid_request_type_, hybrid_qr_code_);
+    if (!weak_this) {
+      return;
+    }
+    if (shown) {
+      hybrid_browser_context_ = hybrid_pending_browser_context_;
+    }
+  }
+
   // Hybrid discovery listens for the phone's BLE advertisement, which on
   // macOS needs the Bluetooth permission. Ask for it now rather than letting
   // the request sit until the OS prompt happens to appear.
@@ -772,6 +794,11 @@ bool ElectronAuthenticatorRequestClientDelegate::SupportsPIN() const {
   // don't listen — e.g. userVerification: 'preferred' requests keep completing
   // without user verification instead of being routed into a PIN exchange
   // that nothing can service.
+  return HasSessionListener(kCollectPinEventName);
+}
