       gin_helper::CallMethod(isolate, session_wrapper, "listenerCount",
-                             std::string(kCollectPinEventName));
+                             std::string(event_name));
   int listener_count = 0;
   return !result.IsEmpty() &&
          gin::ConvertFromV8(isolate, result, &listener_count) &&
