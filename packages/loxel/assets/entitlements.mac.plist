<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Hardened-runtime entitlements Electron needs (electron-builder's defaults). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!--
      Passkeys: the keychain access group Chromium's Touch ID authenticator stores
      WebAuthn credentials under (see src/electron/webauthn.ts). The application
      identifier ties the signature to the embedded Developer ID provisioning
      profile, which must grant these restricted entitlements or macOS refuses to
      launch the app. osx-sign only injects the identifier for sandboxed apps, so
      it is spelled out here.
    -->
    <key>com.apple.application-identifier</key>
    <string>JJ88G244AR.com.bizimind.loxel</string>
    <key>com.apple.developer.team-identifier</key>
    <string>JJ88G244AR</string>
    <key>keychain-access-groups</key>
    <array>
      <string>JJ88G244AR.com.bizimind.loxel.webauthn</string>
    </array>
  </dict>
</plist>
