{
  "name": "@bizimind/cli-common",
  "version": "0.1.0",
  "description": "Common CLI utilities for bizimind packages",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./output": "./src/output.ts",
    "./logging": "./src/logging.ts",
    "./update": "./src/update/index.ts",
    "./commands": "./src/commands/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "pnpm -w run lint",
    "lint:fix": "pnpm -w run lint:fix",
    "fmt": "pnpm -w run fmt",
    "fmt:check": "pnpm -w run fmt:check"
  },
  "dependencies": {
    "@bizimind/logger": "workspace:*",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^24.0.0"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  }
}
