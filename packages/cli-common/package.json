{
  "name": "@bizimind/cli-common",
  "version": "0.1.0",
  "description": "Common CLI utilities for bizimind packages",
  "bin": {
    "bun-compile": "./src/bun-compile.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./output": "./src/output.ts",
    "./update": "./src/update/index.ts",
    "./commands": "./src/commands/index.ts",
    "./bun-compile": "./src/bun-compile.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "pnpm -w run lint",
    "lint:fix": "pnpm -w run lint:fix",
    "fmt": "pnpm -w run fmt",
    "fmt:check": "pnpm -w run fmt:check"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "^24.19.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
