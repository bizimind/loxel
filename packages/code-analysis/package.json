{
  "name": "@bizimind/code-analysis",
  "version": "0.1.7",
  "description": "Live code visualization CLI — treemaps, graphs, and more",
  "bin": {
    "code-analysis": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm -w run lint",
    "lint:fix": "pnpm -w run lint:fix",
    "fmt": "pnpm -w run fmt",
    "fmt:check": "pnpm -w run fmt:check"
  },
  "dependencies": {
    "@bizimind/cli-common": "workspace:*",
    "commander": "^15.0.0",
    "dependency-cruiser": "^17.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^24.13.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
