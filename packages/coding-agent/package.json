{
  "name": "@bizimind/coding-agent",
  "version": "0.1.0",
  "description": "Programmatic coding agent runtime with session persistence, tool orchestration, and JSON-stream protocol",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "import": "./src/schemas.ts"
    }
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/coding-agent",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "pnpm -w run lint",
    "lint:fix": "pnpm -w run lint:fix",
    "fmt": "pnpm -w run fmt",
    "fmt:check": "pnpm -w run fmt:check"
  },
  "dependencies": {
    "@bizimind/cli-common": "workspace:*",
    "@bizimind/logger": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.79",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
