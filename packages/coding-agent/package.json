{
  "name": "@bizimind/coding-agent",
  "version": "0.1.0",
  "description": "Programmatic coding agent runtime with session persistence, tool orchestration, and JSON-stream protocol",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "import": "./src/schemas.ts"
    }
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/coding-agent",
    "typecheck": "tsgo --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@bizimind/cli-common": "workspace:*",
    "@bizimind/logger": "workspace:*",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "ai": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.15.21"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
