{
  "name": "@bizimind/logger",
  "version": "0.1.0",
  "description": "Axiom logging wrapper with error serialization and sensitive data filtering",
  "license": "FSL-1.1-ALv2",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsgo --noEmit",
    "lint": "pnpm -w run lint",
    "lint:fix": "pnpm -w run lint:fix",
    "fmt": "pnpm -w run fmt",
    "fmt:check": "pnpm -w run fmt:check"
  },
  "dependencies": {
    "@axiomhq/js": "^1.8.0",
    "@axiomhq/logging": "^0.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
