{
  "name": "bizimind",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "oxlint --ignore-pattern '**/deps/**'",
    "lint:fix": "oxlint --fix --ignore-pattern '**/deps/**'",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "echo 'You are running `test` at root package. Use `pnpm -C packages/<package> run test` instead' && exit 1",
    "build": "echo 'You are running `build` at root package. Use `pnpm -C packages/<package> run build` instead' && exit 1",
    "typecheck": "pnpm -r --parallel run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "oxfmt": "^0.24.0",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "^0.21.1",
    "typescript": "^6"
  },
  "pnpm": {
    "overrides": {
      "devalue": ">=5.8.1",
      "dompurify": ">=3.4.3",
      "immutable": "4.3.9",
      "js-yaml": "4.3.1",
      "lodash-es": ">=4.18.0",
      "mermaid": ">=11.15.0",
      "nanoid@<3.3.16": "3.3.18",
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "postcss": "8.5.26",
      "sharp": "0.35.3",
      "svgo": "4.0.2",
      "tar@<=7.5.20": "7.5.22",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "ws@>=8.0.0 <8.21.0": "8.21.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "sharp",
      "workerd"
    ]
  }
}
