# Axiom logging token (https://axiom.co)
AXIOM_TOKEN=

# macOS code signing identity (e.g. "Developer ID Application: Name (TEAMID)")
LOXEL_CODESIGN_IDENTITY=

# WorkOS client ID for channel-worker JWT auth
WORKOS_CLIENT_ID=

# Cloudflare R2 credentials for release uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
